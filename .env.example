# MediCard environment configuration
#
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase Dashboard -> Project Settings -> API
#
# NEVER commit the real .env file. `.env` is gitignored; only this example is tracked.
# The anon (public) key is designed for browsers, but it is still a credential:
# keep it out of version control and rely on Row Level Security for real protection.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Phase 6 (AI summaries) - server-side only, set in Supabase Edge Function secrets.
# Never prefix a private key with VITE_; Vite inlines VITE_* into the browser bundle.
# AI_PROVIDER_API_KEY=
